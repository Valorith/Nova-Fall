{
  "name": "@nova-fall/web",
  "version": "0.1.0",
  "private": true,
  "description": "Vue 3 frontend application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter @nova-fall/shared build && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@babylonjs/core": "^7.0.0",
    "@babylonjs/gui": "^7.0.0",
    "@babylonjs/loaders": "^7.0.0",
    "@dagrejs/dagre": "^1.1.4",
    "@nova-fall/shared": "workspace:*",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.1",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^14.1.0",
    "axios": "^1.6.0",
    "pinia": "^2.1.0",
    "pixi.js": "^8.0.0",
    "socket.io-client": "^4.7.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.2.0"
  }
}
